{
  "name": "better-twitter",
  "description": "Better Twitter! - Clean, fast, and respectful Twitter experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/audit-build.mjs",
    "build:firefox": "wxt build -b firefox",
    "audit-build": "node scripts/audit-build.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "wxt build && node scripts/audit-build.mjs && vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@wxt-dev/module-react": "1.2.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "emoji-picker-react": "^4.22.2",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "wxt": "0.21.4"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/auto-icons": "1.1.2",
    "happy-dom": "20.14.5",
    "postcss-rem-to-responsive-pixel": "7.0.5",
    "typescript": "5.7.3",
    "vitest": "5.0.0"
  }
}